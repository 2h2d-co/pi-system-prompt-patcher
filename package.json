{
  "name": "pi-system-prompt-patcher",
  "version": "0.0.3-alpha.0",
  "description": "Patch provider system prompts with exact, config-driven replacements.",
  "keywords": [
    "pi-extension",
    "pi-package",
    "system-prompt"
  ],
  "homepage": "https://github.com/2h2d-co/pi-system-prompt-patcher#readme",
  "bugs": {
    "url": "https://github.com/2h2d-co/pi-system-prompt-patcher/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Kaan Ozdokmeci",
    "email": "kaan@ozdokmeci.com",
    "url": ""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2h2d-co/pi-system-prompt-patcher.git"
  },
  "files": [
    "extensions/index.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "check": "hk check --all --check",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "pack:dry": "npm pack --dry-run --allow-directory=all",
    "release": "node scripts/release.ts",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "devDependencies": {
    "@2h2d/oxlint-config": "0.1.1",
    "@2h2d/ts-config": "0.0.1",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@types/node": "22.20.1",
    "oxfmt": "0.64.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.0 <0.85.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  }
}
